# Copie este archivo como .env y cambie los valores antes de usar datos reales.
POSTGRES_DB=sima
POSTGRES_USER=sima
POSTGRES_PASSWORD=cambie-esta-clave

# Firma de las sesiones (mínimo 32 caracteres) y clave con la que el simulador de PLC o un gateway envía datos
JWT_CLAVE=cambie-esta-clave-en-produccion-sima-v3-0123456789abcdef
SIMA_INGESTA_KEY=cambie-la-clave-de-ingesta

# Clave inicial de las cuentas que se crean al importar el Excel (cada persona debe cambiarla)
SIMA_CLAVE_INICIAL=Sima2026!

# true muestra las cuentas de demostración en las pantallas de ingreso; ponga false en producción
SIMA_DEMO=true
# true mantiene viva la planta con datos simulados cuando no hay un simulador de PLC conectado
SIMA_SIMULADOR_INTERNO=true

# Dominios autorizados (separados por coma). «*» solo para pruebas
CORS_ORIGENES=*
# Dirección pública de la API, si la web no está en el mismo equipo que la API
NEXT_PUBLIC_API_URL=

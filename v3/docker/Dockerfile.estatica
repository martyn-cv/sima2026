# Aplicaciones de interfaz sin servidor propio (app de terreno y simulador de PLC): se compilan y se sirven con nginx.
# Contexto de construcción: v3 (monorepo de npm).   docker build -f docker/Dockerfile.estatica --build-arg APP=terreno .
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY paquetes/cliente/package.json paquetes/cliente/
COPY paquetes/ui/package.json paquetes/ui/
COPY web/package.json web/
COPY plc-sim/package.json plc-sim/
COPY terreno/package.json terreno/
RUN npm ci --no-audit --no-fund
COPY paquetes paquetes
ARG APP
COPY ${APP} ${APP}
RUN npm run build -w ${APP}

FROM nginx:alpine
ARG APP
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/${APP}/dist /usr/share/nginx/html
EXPOSE 80

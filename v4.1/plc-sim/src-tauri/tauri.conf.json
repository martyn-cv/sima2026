{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIMA PLC Simulator",
  "version": "4.1.0",
  "identifier": "cl.manuandina.sima.plcsimulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SIMA PLC Simulator",
        "width": 1560,
        "height": 940,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "backgroundColor": "#05070e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Laboratorio virtual de automatización y simulador de PLC de SIMA",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Manufacturas Andina (demostración)",
    "copyright": "SIMA 4.1 · proyecto experimental"
  }
}

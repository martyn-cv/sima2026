{
  "name": "sima-v4",
  "private": true,
  "version": "4.0.0",
  "description": "SIMA v4: web de administración, app de terreno y simulador de PLC conectados a una sola base de datos",
  "workspaces": [
    "paquetes/*",
    "web",
    "plc-sim",
    "terreno"
  ],
  "scripts": {
    "web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "tipos": "npm run tipos -w web && npm run tipos -w plc-sim && npm run tipos -w terreno",
    "plc": "npm run dev -w plc-sim",
    "build:plc": "npm run build -w plc-sim",
    "terreno": "npm run dev -w terreno",
    "build:terreno": "npm run build -w terreno",
    "plc:escritorio": "npm run tauri -w plc-sim -- dev",
    "terreno:escritorio": "npm run tauri -w terreno -- dev",
    "empaquetar:plc": "npm run tauri -w plc-sim -- build",
    "empaquetar:terreno": "npm run tauri -w terreno -- build",
    "api": "dotnet run --project api/Sima.Api",
    "api:pruebas": "dotnet test api/Sima.Api.Tests"
  }
}

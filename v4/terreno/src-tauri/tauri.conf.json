{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIMA Terreno",
  "version": "3.0.0",
  "identifier": "cl.manuandina.sima.terreno",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SIMA · Terreno",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "App de terreno de SIMA: equipos, alarmas y órdenes de trabajo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
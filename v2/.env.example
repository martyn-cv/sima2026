# Copie este archivo como .env y cambie los valores antes de usar SIMA con datos reales.
DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
# Con dominio real y HTTPS: DJANGO_HTTPS=1 y la lista de orígenes desde los que se abren la web y la app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_HTTPS=0
SIMA_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

POSTGRES_DB=sima
POSTGRES_USER=sima
POSTGRES_PASSWORD=cambie-esta-clave

# Claves iniciales de los usuarios de demostración (mínimo 8 caracteres). Si no las define se usan las del README.
# SIMA_PASSWORD_ADMINISTRATIVO=...   SIMA_PASSWORD_TECNICO=...   (una por rol, en mayúsculas)
SIMA_SEED=1

# Clave que deben enviar los gateways (OPC UA, MQTT, Node-RED...) en la cabecera X-API-Key al publicar lecturas
SIMA_INGESTA_KEY=cambie-esta-clave-de-ingesta
# Minutos tras los cuales una falla simulada sin atender se recupera sola (solo simulador)
SIMA_AUTORECUPERA_MIN=6
